{
  "name": "mcp-action-planner",
  "version": "0.1.0",
  "description": "Metadata-driven MCP server for dynamic action mapping and dependency resolution",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "mcp-action-planner": "./build/index.js"
  },
  "files": ["build"],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js && chmod 755 build/server.js",
    "dev": "tsc --watch --preserveWatchOutput",
    "start:ui": "node --import ./build/loadConfig.js build/server.js",
    "start:ui:watch": "node --watch --import ./build/loadConfig.js build/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
